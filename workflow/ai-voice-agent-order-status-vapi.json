    {
      "id": "n11",
      "name": "Parse Call Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        240
      ],
      "parameters": {
        "jsCode": "\nconst b = $('Vapi Ecom Webhook').first().json.body || {};\nconst m = b.message || {};\nconst call = m.call || {};\nconst art = m.artifact || {};\nreturn [{ json: {\n  callId: call.id || '',\n  callerPhone: (call.customer && call.customer.number) || (call.type === 'webCall' ? 'Web call' : ''),\n  transcript: m.transcript || art.transcript || '',\n  vapiSummary: (m.analysis && m.analysis.summary) || m.summary || '',\n  durationSec: m.durationSeconds != null ? Math.round(m.durationSeconds) : '',\n  cost: m.cost != null ? Number(m.cost).toFixed(3) : '',\n  endedReason: m.endedReason || '',\n  recordingUrl: m.recordingUrl || art.recordingUrl || (art.recording && art.recording.mono && art.recording.mono.combinedUrl) || '',\n}}];\n"
      }
    },
    {
      "id": "n12",
      "name": "AI Call Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        240
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4.1-mini', temperature: 0.2, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: \"You read a phone call transcript between an e-commerce store's AI support agent and a customer. Return JSON with keys: customerName, orderId, intent (one of: Order Status, Return, Cancellation, Product Question, Complaint, Other), resolved (YES or NO), summary (2 short sentences in English). Use empty string when a value was not said. Never invent values.\" }, { role: 'user', content: 'Transcript:\\n' + ($json.transcript || '(empty)') } ] }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "openAiApi": {
          "name": "YOUR_OPENAI_CREDENTIAL"
        }
      }
    },
    {
      "id": "n13",
      "name": "Build Call Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        240
      ],
      "parameters": {
        "jsCode": "\nconst base = $('Parse Call Report').first().json;\nlet ai = {};\ntry { ai = JSON.parse($json.choices[0].message.content); } catch (e) { ai = {}; }\nreturn [{ json: {\n  'Received At': $now.setZone('Asia/Karachi').toFormat('yyyy-MM-dd HH:mm') + ' PKT',\n  'Call ID': base.callId,\n  'Caller Phone': base.callerPhone,\n  'Customer Name': ai.customerName || '',\n  'Order ID': ai.orderId || '',\n  'Intent': ai.intent || 'Other',\n  'Resolved': ai.resolved || '',\n  'Summary': ai.summary || base.vapiSummary,\n  'Duration (sec)': base.durationSec,\n  'Cost ($)': base.cost,\n  'Ended Reason': base.endedReason,\n  'Recording URL': base.recordingUrl,\n}}];\n"
      }
    },
