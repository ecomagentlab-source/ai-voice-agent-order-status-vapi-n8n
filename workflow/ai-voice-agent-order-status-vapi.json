    {
      "id": "n4",
      "name": "Handle Tool Call",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "\nconst body = $('Vapi Ecom Webhook').first().json.body || {};\nconst m = body.message || {};\nconst calls = m.toolCallList || m.toolCalls || [];\nconst callerPhone = (m.call && m.call.customer && m.call.customer.number) || (m.customer && m.customer.number) || '';\nconst orders = $input.all().map(i => i.json).filter(o => o['Order ID']);\nconst digits = s => String(s || '').replace(/\\D/g, '');\nconst find = (id) => { const d = digits(id); return d ? orders.find(o => digits(o['Order ID']) === d) : null; };\nconst results = []; const returnRows = [];\nfor (const tc of calls) {\n  const fn = tc.function || {};\n  let args = fn.arguments || tc.arguments || {};\n  if (typeof args === 'string') { try { args = JSON.parse(args); } catch (e) { args = {}; } }\n  const o = find(args.order_id);\n  let result;\n  if (fn.name === 'check_order_status') {\n    if (!o) result = `No order found with number ${args.order_id || '(not given)'}. Ask the caller to repeat the order number digit by digit. Valid demo order numbers are 4 digits.`;\n    else {\n      const parts = [`Order ${o['Order ID']} for ${o['Customer Name']}: ${o['Quantity']} x ${o['Product']}, total ${o['Amount']}, placed on ${o['Order Date']}.`, `Current status: ${o['Status']}.`];\n      if (o['Courier']) parts.push(`Courier: ${o['Courier']}, tracking number ${o['Tracking Number']}.`);\n      if (o['Expected Delivery'] && !['Delivered','Cancelled'].includes(o['Status'])) parts.push(`Expected delivery: ${o['Expected Delivery']}.`);\n      if (o['Status'] === 'Delivered') parts.push(`It was delivered on ${o['Expected Delivery']}. Returns are allowed within 7 days of delivery.`);\n      parts.push(`Delivery city: ${o['City']}.`);\n      result = parts.join(' ');\n    }\n  } else if (fn.name === 'request_return') {\n    if (!o) result = `No order found with number ${args.order_id || '(not given)'}. A return cannot be created without a valid order number.`;\n    else if (o['Status'] !== 'Delivered') result = `Order ${o['Order ID']} is \"${o['Status']}\", so it cannot be returned yet. Only delivered orders can be returned. If it is not shipped yet, tell the caller a human agent can help with cancellation.`;\n    else {\n      const rid = 'R' + Date.now().toString().slice(-6);\n      returnRows.push({ 'Request ID': rid, 'Received At': $now.setZone('Asia/Karachi').toFormat('yyyy-MM-dd HH:mm') + ' PKT', 'Order ID': o['Order ID'], 'Customer Name': args.customer_name || o['Customer Name'], 'Caller Phone': callerPhone, 'Reason': args.reason || '', 'Status': 'New' });\n      result = `Return request ${rid} created for order ${o['Order ID']} (${o['Product']}). The team will email pickup details within 24 hours and the refund of ${o['Amount']} is processed within 5 to 7 business days after pickup.`;\n    }\n  } else result = `Unknown tool ${fn.name}.`;\n  results.push({ toolCallId: tc.id, result });\n}\nreturn [{ json: { response: { results }, returnRows } }];\n"
      }
    },
